module

public import SE.Individuation.Structural.Whole

set_option autoImplicit false

/-!
# Connectivity Instance

SE.Individuation.Structural.Connectivity

One construction of the equivalence relation `E`: the equivalence relation
generated by a structural bond relation on eligible atoms. The direction of a
bond is immaterial, because the generated equivalence closes it symmetrically.

`BondClosure` is universe-polymorphic. Its agreement with Persistence's
`Generated` at universe 0, and the finite-path characterization, are in
`BoundaryCompatibility`.

Using this construction scientifically requires independently justifying why
bond-connected atoms belong to the same intended whole. Nothing here does that.
-/

namespace SE.Individuation.Structural

universe u v

@[expose] public section

/-- The equivalence relation generated by `r`. -/
inductive BondClosure {C : Type u} (r : C → C → Prop) : C → C → Prop where
  | rel {x y : C} : r x y → BondClosure r x y
  | refl (x : C) : BondClosure r x x
  | symm {x y : C} : BondClosure r x y → BondClosure r y x
  | trans {x y z : C} : BondClosure r x y → BondClosure r y z → BondClosure r x z

namespace BondClosure

variable {C : Type u}

/-- `BondClosure r` is an equivalence relation. -/
theorem equivalence (r : C → C → Prop) : Equivalence (BondClosure r) :=
  ⟨BondClosure.refl, BondClosure.symm, BondClosure.trans⟩

/-- `BondClosure r` is the least equivalence relation containing `r`. -/
theorem le_of_equivalence {r s : C → C → Prop}
    (hs : Equivalence s) (h : ∀ x y, r x y → s x y) {x y : C}
    (hg : BondClosure r x y) : s x y := by
  induction hg with
  | rel hxy => exact h _ _ hxy
  | refl x => exact hs.refl x
  | symm _ ih => exact hs.symm ih
  | trans _ _ ih1 ih2 => exact hs.trans ih1 ih2

/-- A map preserving generators preserves the generated relation. -/
theorem map {D : Type v} {r : C → C → Prop} {r' : D → D → Prop} (g : C → D)
    (h : ∀ x y, r x y → r' (g x) (g y)) {x y : C}
    (hg : BondClosure r x y) : BondClosure r' (g x) (g y) := by
  induction hg with
  | rel hxy => exact BondClosure.rel (h _ _ hxy)
  | refl x => exact BondClosure.refl (g x)
  | symm _ ih => exact BondClosure.symm ih
  | trans _ _ ih1 ih2 => exact BondClosure.trans ih1 ih2

/-- An element with no bond in either direction is connected only to itself. -/
theorem eq_of_isolated {r : C → C → Prop} {a : C}
    (hiso : ∀ y, ¬ r a y ∧ ¬ r y a) {x y : C} (h : BondClosure r x y) :
    (x = a → y = a) ∧ (y = a → x = a) := by
  induction h with
  | rel hxy =>
    rename_i x' y'
    refine ⟨fun hx => ?_, fun hy => ?_⟩
    · subst hx
      exact absurd hxy (hiso y').1
    · subst hy
      exact absurd hxy (hiso x').2
  | refl x => exact ⟨id, id⟩
  | symm _ ih => exact ⟨ih.2, ih.1⟩
  | trans _ _ ih1 ih2 =>
    exact ⟨fun hx => ih2.1 (ih1.1 hx), fun hz => ih1.2 (ih2.2 hz)⟩

end BondClosure

namespace Setting

variable {A Presentation : Type u}

/-- A setting whose co-membership is the equivalence generated by `bond`. -/
def BondGenerated (s : Setting A Presentation)
    (bond : {a : A // a ∈ s.eligible} → {a : A // a ∈ s.eligible} → Prop) : Prop :=
  ∀ x y, s.E x y ↔ BondClosure bond x y

/-- The connectivity instance: co-membership is the equivalence generated by `bond`. -/
def ofBonds (eligible : MathlibMini.Set A)
    (admissible : Presentation → Prop) (support : Presentation → MathlibMini.Set A)
    (support_subset_eligible : ∀ p, admissible p → support p ⊆ eligible)
    (bond : {a : A // a ∈ eligible} → {a : A // a ∈ eligible} → Prop) :
    Setting A Presentation where
  eligible := eligible
  admissible := admissible
  support := support
  support_subset_eligible := support_subset_eligible
  E := BondClosure bond
  E_equivalence := BondClosure.equivalence bond

/-- A setting built from bonds is bond-generated. -/
theorem ofBonds_bondGenerated (eligible : MathlibMini.Set A)
    (admissible : Presentation → Prop) (support : Presentation → MathlibMini.Set A)
    (support_subset_eligible : ∀ p, admissible p → support p ⊆ eligible)
    (bond : {a : A // a ∈ eligible} → {a : A // a ∈ eligible} → Prop) :
    (ofBonds eligible admissible support support_subset_eligible bond).BondGenerated bond :=
  fun _ _ => Iff.rfl

/-- Bonded atoms are co-members. -/
theorem BondGenerated.coMember_of_bond {s : Setting A Presentation}
    {bond : {a : A // a ∈ s.eligible} → {a : A // a ∈ s.eligible} → Prop}
    (hs : s.BondGenerated bond) {x y : {a : A // a ∈ s.eligible}}
    (h : bond x y) : s.CoMember x.1 y.1 :=
  CoMember.of_E ((hs x y).2 (BondClosure.rel h))

/-- Co-membership is the least equivalence relation containing the bonds. -/
theorem BondGenerated.le_of_equivalence {s : Setting A Presentation}
    {bond : {a : A // a ∈ s.eligible} → {a : A // a ∈ s.eligible} → Prop}
    (hs : s.BondGenerated bond)
    {R : {a : A // a ∈ s.eligible} → {a : A // a ∈ s.eligible} → Prop}
    (hR : Equivalence R) (hb : ∀ x y, bond x y → R x y)
    {x y : {a : A // a ∈ s.eligible}} (h : s.E x y) : R x y :=
  BondClosure.le_of_equivalence hR hb ((hs x y).1 h)

/-- If the class of an eligible atom is only that atom, the singleton meets the whole conditions.
Whether a singleton is a whole of the intended kind is decided by independently warranted
judgments for that kind, not by this construction. -/
theorem wholeConditions_singleton_of_isolated {s : Setting A Presentation} {a : A}
    (ha : a ∈ s.eligible) (hiso : ∀ b, s.CoMember a b → b = a) :
    s.WholeConditions {a} := by
  refine ⟨⟨a, rfl, ha⟩, ?_, ?_⟩
  · intro b c hb hc
    have hb' : b = a := hb
    have hc' : c = a := hc
    rw [hb', hc']
    exact CoMember.refl ha
  · intro b c hb _ hbc
    have hb' : b = a := hb
    rw [hb'] at hbc
    exact hiso c hbc

/-- In a bond-generated setting, an eligible atom with no bond forms a singleton whole. -/
theorem BondGenerated.wholeConditions_singleton_of_no_bond {s : Setting A Presentation}
    {bond : {a : A // a ∈ s.eligible} → {a : A // a ∈ s.eligible} → Prop}
    (hs : s.BondGenerated bond) {a : A} (ha : a ∈ s.eligible)
    (hiso : ∀ y, ¬ bond ⟨a, ha⟩ y ∧ ¬ bond y ⟨a, ha⟩) :
    s.WholeConditions {a} := by
  refine wholeConditions_singleton_of_isolated ha ?_
  intro b hab
  obtain ⟨_, hb, hE⟩ := hab
  have hcl := BondClosure.eq_of_isolated hiso ((hs _ _).1 hE)
  have heq : (⟨b, hb⟩ : {a : A // a ∈ s.eligible}) = ⟨a, ha⟩ := hcl.1 rfl
  exact congrArg Subtype.val heq

end Setting

end

end SE.Individuation.Structural
